# 统一换行符，避免 git 每次报告 "LF will be replaced by CRLF"
* text=auto

# PowerShell 与批处理：Windows 上按 CRLF 检出
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# 其余文本文件按 LF，保证跨平台一致
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制（本项目目前没有，先留好规则）
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
