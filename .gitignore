# ============================================================================
# Win11-Optimizer — .gitignore
#
# 原则：只忽略"运行时产生的噪声"和编辑器的本地配置，
#       analyzer\ 与 ci\ 下的真实源码（.ps1 / .psm1 / .psd1 / 夹具）一律入库。
# ============================================================================

# ---- Windows 系统噪声 ----------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- 编辑器 / IDE --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 通用临时文件与备份 --------------------------------------------------
*.tmp
*.temp
*.bak
*.old
*.orig
*.zip
*.7z
*.rar

# ---- 日志（PRD §10.3 的 Logs\ 约定）-------------------------------------
*.log
Logs/

# ---- 工具的运行时产物（由引擎/插件生成，不属于源码）---------------------
# 改动前的状态快照（PRD §7.1）
Snapshot/
# 诊断报告与日志（本地运行产物，不入库）
Reports/
Logs/
# 自动生成的一键还原脚本（PRD §7.2）——由快照重建，不入库
# 只忽略仓库根目录那一份，避免误伤未来插件目录里的同名脚本
/Restore-All.ps1
# 上一次实战留下的备份目录
优化备份/
# 带时间戳的中间产物目录，例如 20261004-143022\
[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]/
# 运行总账
manifest*.json

# ---- analyzer / CI 运行产物（源码本身不忽略）----------------------------
# Pester 结果文件
TestResults*.xml
testResults.xml
*.trx
Pester*.xml
Pester*.json
# 本地试验用的临时输出目录（放在 analyzer\experimental\ 下时不要入库）
analyzer/experimental/scratch/
analyzer/experimental/tmp/
*.pestercache

# ---- 个人环境文件 --------------------------------------------------------
# 本机专属配置（机型/路径/偏好），不要提交
*.local.json
*.local.ps1
local.settings.json
